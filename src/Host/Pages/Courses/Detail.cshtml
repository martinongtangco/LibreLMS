@page "{id:guid}"
@model CourseDetailModel
@{
    ViewData["Title"] = Model.Course?.Title ?? "Course Not Found";
}

@if (Model.Course is null)
{
    <div class="card empty-state">
        <h2>Course Not Found</h2>
        <p>The course you are looking for does not exist.</p>
        <a asp-page="Index" class="btn btn-primary">Back to Catalog</a>
    </div>
}
else
{
    <div class="back-link mb-md">
        <a asp-page="Index" class="link-muted">&larr; Back to courses</a>
    </div>

    <div class="card">
        <div class="course-card-badges mb-md">
            <span class="tag tag-neutral">@Model.Course.Category</span>
            <span class="tag tag-outline">@Model.Course.Duration</span>
        </div>
        <h1>@Model.Course.Title</h1>
        <p class="text-muted mb-md">@Model.Course.ShortDescription</p>
        <hr class="separator" />
        <h3>Full Description</h3>
        <p class="mt-sm" style="white-space: pre-wrap;">@Model.Course.FullDescription</p>

        <div id="enroll-region" class="enroll-region">
            @if (Model.Course.IsEnrolled)
            {
                <button class="btn btn-secondary" disabled>✓ Enrolled</button>
                @if (Model.Course.IsScorm)
                {
                    var displayLabel = ScormHelpers.GetDisplayLabel(Model.LatestStatus);
                    <span class="tag tag-accent-2">@displayLabel</span>
                    <span class="text-muted" style="font-size: 0.85rem; vertical-align: middle;">
                        @ScormHelpers.GetDisplayPercentage(Model.LatestScore)
                    </span>
                    <a asp-page="/Scorm/Launch" asp-route-courseId="@Model.Course.Id" class="btn btn-primary">Launch SCORM Course</a>
                }
            }
            else
            {
                <form hx-post="/Courses/Detail?handler=Enroll"
                      hx-vals='{"courseId": "@Model.Course.Id"}'
                      hx-swap="outerHTML"
                      hx-target="#enroll-region">
                    <button type="submit" class="btn btn-primary">Enroll now</button>
                </form>
            }
        </div>
    </div>
}
