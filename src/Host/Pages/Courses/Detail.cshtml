@page "{id:guid}"
@using LearningLms.Host.Pages.Courses
@model CourseDetailModel
@{
    ViewData["Title"] = Model.Course?.Title ?? "Course Not Found";
}

@if (Model.Course is null)
{
    <div class="card empty-state">
        <h2>Course Not Found</h2>
        <p>The course you are looking for does not exist.</p>
        <a asp-page="Index" class="btn btn-primary">Back to Catalog</a>
    </div>
}
else
{
    <div style="margin-bottom: 1rem;">
        <a asp-page="Index" style="color: #666; text-decoration: none;">&larr; Back to Catalog</a>
    </div>

    <div class="card">
        <h1>@Model.Course.Title</h1>
        <div style="display: flex; gap: 0.5rem; margin: 0.75rem 0;">
            <span class="badge badge-category">@Model.Course.Category</span>
            <span class="badge badge-duration">@Model.Course.Duration</span>
        </div>
        <p style="font-size: 1.1rem; margin-bottom: 1rem;">@Model.Course.ShortDescription</p>
        <hr style="border: none; border-top: 1px solid #eee; margin: 1.5rem 0;" />
        <h3>Full Description</h3>
        <p style="white-space: pre-wrap; margin-top: 0.5rem;">@Model.Course.FullDescription</p>

        <div id="enroll-region" style="margin-top: 1.5rem;">
            @if (Model.Course.IsEnrolled)
            {
                <span class="badge badge-enrolled" style="font-size: 1rem; padding: 0.4rem 1rem;">✓ Enrolled</span>
                @if (Model.Course.IsScorm)
                {
                    <a asp-page="/Scorm/Launch" asp-route-courseId="@Model.Course.Id" class="btn btn-primary" style="margin-left: 1rem;">Launch SCORM Course</a>
                }
            }
            else
            {
                <form hx-post="/Courses/Detail?handler=Enroll"
                      hx-vals='{"courseId": "@Model.Course.Id"}'
                      hx-swap="outerHTML"
                      hx-target="#enroll-region">
                    <button type="submit" class="btn btn-primary">Enroll in This Course</button>
                </form>
            }
        </div>
    </div>
}
