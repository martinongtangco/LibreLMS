@page
@model ResetPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Succeeded ? "Password updated" : "Reset password";
}

<div class="login-container">
    <div class="card">
        @if (Model.Succeeded)
        {
            <h1 class="mb-lg">Password updated</h1>
            <p>Your password has been changed. All previous sessions have been signed out.</p>
            <a asp-page="Login" class="btn btn-primary">Sign in</a>
        }
        else if (!Model.TokenPending && Model.StatusTitle is not null)
        {
            <h1 class="mb-lg">@Model.StatusTitle</h1>
            <p>@Model.StatusBody</p>
            <a asp-page="ForgotPassword" class="btn btn-primary">Request a new reset link</a>
        }
        else
        {
            <h1 class="mb-lg">Choose a new password</h1>

            @if (Model.ConfirmError is not null)
            {
                <div class="error-message mb-md">@Model.ConfirmError</div>
            }

            <form method="post">
                <input type="hidden" asp-for="Token" />

                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label">New password</label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                    @if (Model.PasswordError is not null)
                    {
                        <div class="field-error">@Model.PasswordError</div>
                    }
                    <ul class="password-hints">
                        <li>At least 12 characters</li>
                        <li>At least one uppercase letter, one lowercase letter and one digit</li>
                        <li>Must not contain your full name or email address</li>
                        <li>Must not be a commonly used password</li>
                    </ul>
                </div>

                <div class="form-group mb-lg">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn btn-primary">Update password</button>
            </form>
        }
    </div>
</div>
