@page
@model ForgotPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot password";
}

<div class="login-container">
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Confirmation))
        {
            <h1 class="mb-lg">Check your email</h1>
            <p>@Model.Confirmation</p>
            <p class="text-faint">The link (if sent) expires in 30 minutes and works once.</p>
            <a asp-page="Login" class="btn btn-primary">Back to sign in</a>
        }
        else
        {
            <h1 class="mb-lg">Forgot your password?</h1>
            <p>Enter the email address of your account and we'll send you a link to choose a new password.</p>

            <form method="post">
                <div class="form-group mb-lg">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Send reset link</button>
            </form>

            <p class="mt-md text-faint">
                Remembered it? <a asp-page="Login">Sign in</a>
            </p>
        }
    </div>
</div>
