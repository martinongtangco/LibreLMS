@page
@model LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <div class="card">
        @if (Model.AccessDenied)
        {
            <h1 class="mb-lg">Access denied</h1>
            <p>You are signed in@(Model.SignedInAs is null ? string.Empty : $" as {Model.SignedInAs}") but your role does not allow access to that page.</p>
            <a href="/Courses" class="btn btn-primary">Browse courses</a>
            return;
        }

        <h1 class="mb-lg">Login</h1>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error-message mb-md">
                @Model.Error
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.UnverifiedEmail))
        {
            <div class="error-message mb-md">
                Your email address has not been verified. Please check your email for the verification link.
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ResendMessage))
        {
            <div class="error-message mb-md">
                @Model.ResendMessage
            </div>
        }

        <form method="post">
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>

            <div class="form-group mb-lg">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Sign In</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.UnverifiedEmail))
        {
            <form method="post" asp-page-handler="Resend" class="mt-lg">
                <input type="hidden" name="email" value="@Model.UnverifiedEmail" />
                <button type="submit" class="btn btn-secondary">Resend verification email</button>
            </form>
        }
    </div>
</div>
