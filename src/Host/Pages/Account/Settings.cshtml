@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success mb-md">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-md">@Model.ErrorMessage</div>
}

<form method="post" id="settings-form">
    <div class="card">
        <div class="settings-row">
            <div>
                <div class="settings-label">Email Notifications</div>
                <div class="settings-description">Receive email notifications about course updates and enrollments.</div>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" asp-for="EmailNotificationsEnabled"
                       onchange="document.getElementById('settings-form').requestSubmit()" />
                <span class="slider"></span>
            </label>
        </div>

        <div class="settings-row">
            <div>
                <div class="settings-label">Theme</div>
                <div class="settings-description">Choose your preferred theme appearance.</div>
            </div>
            <select asp-for="ThemePreference" class="form-select" style="width: auto; min-width: 120px;"
                    onchange="document.getElementById('settings-form').requestSubmit()">
                <option value="System">System</option>
                <option value="Light">Light</option>
                <option value="Dark">Dark</option>
            </select>
        </div>
    </div>
</form>

<div class="card mt-md">
    <div class="settings-row">
        <div>
            <div class="settings-label">Logout</div>
            <div class="settings-description">Sign out of your account.</div>
        </div>
        <form method="post" asp-page="/Account/Logout" style="display: inline;">
            <button type="submit" class="btn btn-ghost" style="color: var(--color-error-border);">
                Logout
            </button>
        </form>
    </div>
</div>
