@page "{courseId:guid}"
@model ScormLaunchModel
@{
    Layout = null;
    ViewData["Title"] = "SCORM Course";
}

@if (Model.Error is not null)
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Error - Libre LMS</title>
        <link href="/css/site.css" rel="stylesheet" />
        <style>
            body { padding: 2rem; }
        </style>
    </head>
    <body>
        <div class="scorm-error-page">
            <h1>Launch Failed</h1>
            <p>@Model.Error</p>
            <a asp-page="/MyCourses/Index" class="btn btn-primary">Back to My Courses</a>
        </div>
    </body>
    </html>
}
else
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>SCORM Course - Libre LMS</title>
        <link href="/css/site.css" rel="stylesheet" />
        <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body, html { height: 100%; overflow: hidden; font-family: var(--font-family); }
        </style>
    </head>
    <body>
        <iframe class="scorm-frame" src="@Model.ContentUrl"></iframe>

        @if (Model.SessionId is not null)
        {
            <!-- SCORM API shim — injected into iframe via script tag in the content -->
            <script>
                // Make session info available to child frames
                window.scormSessionId = '@Model.SessionId';
                window.scormBaseUrl = '/api/scorm/session/@Model.SessionId';
            </script>
        }

        <div class="scorm-status-bar">
            <span>
                <span class="entry-badge">@Model.Entry</span>
                SCORM Session Active
            </span>
            <a href="/MyCourses" style="color: white; text-decoration: none; font-size: 0.85rem;">My Courses &rarr;</a>
        </div>

        <script>
            // Auto-commit on page/tab close
            window.addEventListener('beforeunload', function(event) {
                var sessionId = '@Model.SessionId';
                if (sessionId) {
                    // Use sendBeacon for reliable delivery during page unload
                    navigator.sendBeacon('/api/scorm/session/' + sessionId + '/commit', new Blob([], { type: 'application/json' }));
                }
            });
        </script>
    </body>
    </html>
}
