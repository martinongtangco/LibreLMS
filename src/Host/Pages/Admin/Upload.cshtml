@page
@model LibreLms.Host.Pages.Admin.ScormUploadModel
@{
    ViewData["Title"] = "SCORM Package Pool";
}

<h1 class="mb-lg">SCORM Package Pool</h1>

@if (Model.SuccessMessage is not null)
{
    <div class="card card-success">
        <h3>@Model.SuccessMessage</h3>
    </div>
}

@if (Model.Error is not null)
{
    <div class="card card-error">
        <h3>Error</h3>
        <p>@Model.Error</p>
    </div>
}

<div class="card">
    <h3>Upload SCORM Package</h3>
    <form method="post" enctype="multipart/form-data">
        <div class="form-group mb-lg">
            <label class="form-label">SCORM Package (.zip)</label>
            <input type="file" name="package" accept=".zip" class="form-file" required />
            <small class="form-hint">Upload a SCORM 1.2 ZIP package containing imsmanifest.xml (max 50MB). The package will be added to the available pool.</small>
        </div>

        <button type="submit" class="btn btn-primary">Upload to Pool</button>
    </form>
</div>

<div class="card" style="margin-top: var(--spacing-md);">
    <h3>Available SCORM Packages (@Model.AvailablePackages.Count)</h3>

    @if (Model.AvailablePackages.Count == 0)
    {
        <div class="empty-state">
            No available SCORM packages. Upload a package above to add it to the pool.
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Uploaded</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pkg in Model.AvailablePackages)
                    {
                        <tr>
                            <td>@pkg.ManifestTitle</td>
                            <td>@pkg.CreatedAt</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" asp-route-packageId="@pkg.Id" style="display:inline;" onsubmit="return confirm('Delete this SCORM package and its extracted files?');">
                                    <button type="submit" class="btn btn-sm btn-secondary" style="background:#c62828; color:white;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
