@page
@model LibreLms.Host.Pages.Admin.ScormUploadModel
@{
    ViewData["Title"] = "Upload SCORM Package";
}

<h1 class="mb-lg">Upload SCORM Package</h1>

@if (Model.SuccessMessage is not null)
{
    <div class="card card-success">
        <h3>@Model.SuccessMessage</h3>
        @if (Model.UploadedCourseId.HasValue)
        {
            <p class="mt-sm">
                <a asp-page="/Courses/Detail" asp-route-id="@Model.UploadedCourseId" class="btn btn-primary">View Course</a>
            </p>
        }
    </div>
}

@if (Model.Error is not null)
{
    <div class="card card-error">
        <h3>Error</h3>
        <p>@Model.Error</p>
    </div>
}

<div id="upload-result"></div>

<div class="card">
    <form method="post"
          enctype="multipart/form-data"
          hx-post="."
          hx-encoding="multipart/form-data"
          hx-target="#upload-result"
          hx-indicator=".htmx-indicator">
        <div class="form-group">
            <label class="form-label">Course</label>
            <select name="courseId" class="form-select">
                <option value="">— Select a course —</option>
                @foreach (var course in Model.Courses)
                {
                    <option value="@course.Id">@course.Title <small>(@course.OrganizationName)</small></option>
                }
            </select>
            <small class="form-hint">Select the course from the catalog to associate with this SCORM package. Organization shown in parentheses.</small>
        </div>

        <div class="form-group mb-lg">
            <label class="form-label">SCORM Package (.zip)</label>
            <input type="file" name="package" accept=".zip" class="form-file" />
            <small class="form-hint">Upload a SCORM 1.2 ZIP package containing imsmanifest.xml.</small>
        </div>

        <button type="submit" class="btn btn-primary">Upload Package</button>
        <div class="htmx-indicator text-muted">⏳ Uploading...</div>
    </form>
</div>
