@page
@model LibreLms.Host.Pages.Admin.Organizations.ChartModel
@{
    ViewData["Title"] = "Organization Chart";
}

<h1>Organization Chart</h1>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card">
    <div class="chart-toolbar">
        <button id="zoom-in-btn" class="btn btn-secondary" title="Zoom In">+</button>
        <button id="zoom-out-btn" class="btn btn-secondary" title="Zoom Out">−</button>
        <button id="zoom-reset-btn" class="btn btn-secondary" title="Reset View">Reset</button>
    </div>

    <div class="chart-viewport">
        <svg id="org-chart-svg" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 600px; cursor: grab;">
            <g id="chart-content">
                @if (Model.Nodes != null && Model.Nodes.Any())
                {
                    @await Html.PartialAsync("_OrgChartSvg", Model.Nodes)
                }
                else
                {
                    @Html.Raw("<text x=\"400\" y=\"300\" text-anchor=\"middle\" fill=\"#999\" font-size=\"16\">No organizations found.</text>")
                }
            </g>
        </svg>
    </div>
</div>

<div id="notification-area"></div>
<div id="modal-container"></div>

<div id="org-context-menu" class="org-context-menu" style="display: none;"></div>

<script src="/js/org-chart.js"></script>
