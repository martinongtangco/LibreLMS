@page
@model LibreLms.Host.Pages.Admin.Organizations.IndexModel
@{
    ViewData["Title"] = "Organizations";
}

<h1>Organization Management</h1>

<p class="mb-lg">
    <a asp-page="Chart" class="btn btn-primary">Org Chart View</a>
    <a asp-page="Create" class="btn btn-secondary">Create Organization</a>
</p>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else
{
    <ul class="org-tree" aria-label="Organization hierarchy">
        @foreach (var node in Model.OrgTree)
        {
            <partial name="_OrgNode" model="node" />
        }
    </ul>
}
