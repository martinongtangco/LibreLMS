@page
@model LibreLms.Host.Pages.Admin.Organizations.CreateModel
@{
    ViewData["Title"] = "Create Organization";
}

<h1>Create Organization</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label">Description</label>
        <input asp-for="Input.Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.ParentId" class="form-label">Parent Organization</label>
        <select asp-for="Input.ParentId" asp-items="Model.ParentOrgs" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
