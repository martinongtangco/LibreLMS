@page
@model LibreLms.Host.Pages.Admin.Enrollments.IndexModel
@{
    ViewData["Title"] = "Enrollment Management";
}

<h1>Enrollment Management</h1>

<p>
    <a asp-page="BulkEnroll" class="btn btn-primary">Bulk Enroll</a>
</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="get" class="filters">
    <input name="student" value="@Model.SearchStudent" placeholder="Search by student name..." />
    <input name="course" value="@Model.SearchCourse" placeholder="Search by course title..." />
    <input type="hidden" name="pageNumber" value="1" />
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a asp-page="Index" class="btn btn-secondary">Clear</a>
</form>

@if (Model.Enrollments.Count == 0)
{
    <div class="empty-state">No enrollments found.</div>
}
else
{
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th>Organization</th>
                    <th>Enrolled</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrollment in Model.Enrollments)
                {
                    <tr>
                        <td>@enrollment.StudentName</td>
                        <td class="email-cell">@enrollment.StudentEmail</td>
                        <td>@enrollment.CourseTitle</td>
                        <td>@enrollment.OrganizationName</td>
                        <td>@enrollment.EnrolledAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <form method="post" asp-page-handler="Cancel" asp-route-enrollmentId="@enrollment.EnrollmentId" onsubmit="return confirm('Cancel this enrollment?');">
                                <input type="hidden" name="student" value="@Model.SearchStudent" />
                                <input type="hidden" name="course" value="@Model.SearchCourse" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                <button type="submit" class="btn btn-secondary" style="background:#c62828; color:white;">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Pagination != null)
{
    <partial name="_AdminPagination" model="Model.Pagination" />
}
