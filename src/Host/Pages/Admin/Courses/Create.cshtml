@page
@model CreateCourseModel
@{
    ViewData["Title"] = "Create Course";
}

<h1 class="mb-lg">Create New Course</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="card card-success">
        <h3>@Model.SuccessMessage</h3>
        @if (Model.CreatedCourseId.HasValue)
        {
            <p class="mt-sm">
                <a asp-page="/Courses/Detail" asp-route-id="@Model.CreatedCourseId" class="btn btn-primary">View Course</a>
            </p>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="card card-error">
        <h3>Error</h3>
        <p>@Model.Error</p>
    </div>
}

<div class="card">
    <form method="post">
        <div class="form-group">
            <label asp-for="Title" class="form-label">Title *</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="ShortDescription" class="form-label">Short Description *</label>
            <input asp-for="ShortDescription" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="FullDescription" class="form-label">Full Description *</label>
            <textarea asp-for="FullDescription" rows="5" class="form-textarea"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Category" class="form-label">Category *</label>
            <input asp-for="Category" class="form-control" />
            <small class="form-hint">e.g., Programming, Design, Database, Tools</small>
        </div>

        <div class="form-group mb-lg">
            <label asp-for="Duration" class="form-label">Duration *</label>
            <input asp-for="Duration" class="form-control" />
            <small class="form-hint">e.g., 3 hours, 2 days</small>
        </div>

        <button type="submit" class="btn btn-primary">Create Course</button>
        <a asp-page="/Courses/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
