@page
@model CreateCourseModel
@{
    ViewData["Title"] = "Create Course";
}

<h1 class="mb-lg">Create New Course</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="card card-success">
        <h3>@Model.SuccessMessage</h3>
        @if (Model.CreatedCourseId.HasValue)
        {
            <p class="mt-sm">
                <a asp-page="/Courses/Detail" asp-route-id="@Model.CreatedCourseId" class="btn btn-primary">View Course</a>
            </p>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="card card-error">
        <h3>Error</h3>
        <p>@Model.Error</p>
    </div>
}

<div class="card">
    <form method="post">
        <div class="form-group">
            <label asp-for="Title" class="form-label">Title *</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="ShortDescription" class="form-label">Short Description *</label>
            <input asp-for="ShortDescription" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="FullDescription" class="form-label">Full Description *</label>
            <textarea asp-for="FullDescription" rows="5" class="form-textarea"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Category" class="form-label">Category *</label>
            <input asp-for="Category" class="form-control" />
            <small class="form-hint">e.g., Programming, Design, Database, Tools</small>
        </div>

        <div class="form-group mb-lg">
            <label asp-for="Duration" class="form-label">Duration *</label>
            <input asp-for="Duration" class="form-control" />
            <small class="form-hint">e.g., 3 hours, 2 days</small>
        </div>

        <div class="form-group mb-lg">
            <label class="form-label">SCORM Content</label>

            <div class="radio-group" style="display:flex; flex-direction:column; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm);">
                <label style="display:flex; align-items:center; gap: var(--spacing-sm);">
                    <input type="radio" name="ScormMode" value="none" checked onchange="toggleScormOptions()" />
                    No SCORM content
                </label>
                <label style="display:flex; align-items:center; gap: var(--spacing-sm);">
                    <input type="radio" name="ScormMode" value="upload" onchange="toggleScormOptions()" />
                    Upload new SCORM package
                </label>
                <label style="display:flex; align-items:center; gap: var(--spacing-sm);">
                    <input type="radio" name="ScormMode" value="associate" onchange="toggleScormOptions()" />
                    Associate existing SCORM package
                </label>
            </div>

            <div id="scormUploadSection" style="display:none; margin-top: var(--spacing-sm);">
                <input type="file" name="ScormFile" accept=".zip" class="form-file" />
                <small class="form-hint">Upload a SCORM 1.2 ZIP package (max 50MB).</small>
            </div>

            <div id="scormAssociateSection" style="display:none; margin-top: var(--spacing-sm);">
                <select name="ScormPackageId" class="form-select">
                    <option value="">— Select a SCORM package —</option>
                    @foreach (var pkg in Model.AvailableScormPackages)
                    {
                        <option value="@pkg.Id">@pkg.ManifestTitle <small>(@pkg.CreatedAt)</small></option>
                    }
                </select>
                @if (Model.AvailableScormPackages.Count == 0)
                {
                    <small class="form-hint">No available SCORM packages. <a asp-page="/Admin/Upload">Upload one first</a>.</small>
                }
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create Course</button>
        <a asp-page="/Admin/Courses" class="btn btn-secondary">Cancel</a>
    </form>
</div>

<script>
function toggleScormOptions() {
    var mode = document.querySelector('input[name="ScormMode"]:checked').value;
    document.getElementById('scormUploadSection').style.display = mode === 'upload' ? 'block' : 'none';
    document.getElementById('scormAssociateSection').style.display = mode === 'associate' ? 'block' : 'none';
}
</script>
