@page
@model LibreLms.Host.Pages.Admin.Courses.IndexModel
@{
    ViewData["Title"] = "Course Management";
}

<h1>Course Management</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (Model.Courses.Count == 0)
{
    <div class="empty-state">No courses found.</div>
}
else
{
    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#f5f5f5; text-align:left;">
                    <th style="padding:0.75rem; border-bottom:2px solid #ddd;">Title</th>
                    <th style="padding:0.75rem; border-bottom:2px solid #ddd;">Category</th>
                    <th style="padding:0.75rem; border-bottom:2px solid #ddd;">Organization</th>
                    <th style="padding:0.75rem; border-bottom:2px solid #ddd;">Source</th>
                    <th style="padding:0.75rem; border-bottom:2px solid #ddd;">Visibility</th>
                    <th style="padding:0.75rem; border-bottom:2px solid #ddd;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td style="padding:0.75rem; border-bottom:1px solid #eee;">@course.Title</td>
                        <td style="padding:0.75rem; border-bottom:1px solid #eee;">
                            <span class="badge badge-category">@course.Category</span>
                        </td>
                        <td style="padding:0.75rem; border-bottom:1px solid #eee;">@course.OrganizationName</td>
                        <td style="padding:0.75rem; border-bottom:1px solid #eee;">
                            <span class="badge @(course.Source == "Inherited" ? "badge-duration" : "badge-enrolled")">@course.Source</span>
                        </td>
                        <td style="padding:0.75rem; border-bottom:1px solid #eee;">
                            <span class="badge @(course.Visibility == "Hidden" ? "badge-category" : "badge-enrolled")">@course.Visibility</span>
                        </td>
                        <td style="padding:0.75rem; border-bottom:1px solid #eee;">
                            <form method="post" style="display:inline;" asp-page-handler="Delete" asp-route-courseId="@course.CourseId" onsubmit="return confirm('Are you sure you want to delete this course?');">
                                <button type="submit" class="btn btn-secondary" style="padding:0.25rem 0.5rem; font-size:0.8rem; background:#c62828; color:white;">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
