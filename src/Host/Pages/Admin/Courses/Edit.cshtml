@page
@model EditCourseModel
@{
    ViewData["Title"] = "Edit Course";
}

<h1>Edit Course</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="card card-error">
        <h3>Error</h3>
        <p>@Model.Error</p>
    </div>
}

<div class="card">
    <form method="post">
        <input type="hidden" asp-for="CourseId" />

        <div class="form-group">
            <label asp-for="Title" class="form-label">Title *</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="ShortDescription" class="form-label">Short Description *</label>
            <input asp-for="ShortDescription" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="FullDescription" class="form-label">Full Description *</label>
            <textarea asp-for="FullDescription" rows="5" class="form-textarea"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Category" class="form-label">Category *</label>
            <input asp-for="Category" class="form-control" />
            <small class="form-hint">e.g., Programming, Design, Database, Tools</small>
        </div>

        <div class="form-group mb-lg">
            <label asp-for="Duration" class="form-label">Duration *</label>
            <input asp-for="Duration" class="form-control" />
            <small class="form-hint">e.g., 3 hours, 2 days</small>
        </div>

        <div class="form-group mb-lg">
            <label class="form-label">SCORM Content</label>

            @if (Model.CurrentScormPackage != null)
            {
                <div class="card" style="margin-bottom: var(--spacing-sm); padding: var(--spacing-sm);">
                    <p><strong>@Model.CurrentScormPackage.ManifestTitle</strong></p>
                    <small class="form-hint">Uploaded @Model.CurrentScormPackage.CreatedAt.ToString("yyyy-MM-dd")</small>
                </div>
                <label class="form-label">Upload new SCORM to replace</label>
                <input type="file" name="ScormFile" accept=".zip" class="form-file" />
                <small class="form-hint">Uploading a new package will replace the existing SCORM content (max 50MB).</small>
            }
            else
            {
                <label class="form-label">Upload SCORM package</label>
                <input type="file" name="ScormFile" accept=".zip" class="form-file" />
                <small class="form-hint">Upload a SCORM 1.2 ZIP package (max 50MB). Leave empty to keep current state.</small>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-page="/Admin/Courses" class="btn btn-secondary">Cancel</a>
    </form>
</div>
