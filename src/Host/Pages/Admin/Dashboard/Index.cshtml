@page
@model LibreLms.Host.Pages.Admin.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

@if (!string.IsNullOrEmpty(Model.OrganizationName))
{
    <p class="text-muted">Viewing metrics for: <strong>@Model.OrganizationName</strong> (Org Admin scope)</p>
}
else
{
    <p class="text-muted">System-wide metrics (SuperUser)</p>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<!-- Metric Cards -->
<div class="metric-cards">
    <div class="card metric-card">
        <div class="metric-value" style="color: #1a1a2e;">@Model.TotalOrganizations</div>
        <div class="metric-label">Organizations</div>
    </div>
    <div class="card metric-card">
        <div class="metric-value" style="color: #1565c0;">@Model.TotalLearners</div>
        <div class="metric-label">Learners</div>
    </div>
    <div class="card metric-card">
        <div class="metric-value" style="color: #7b1fa2;">@Model.TotalCourses</div>
        <div class="metric-label">Courses</div>
    </div>
    <div class="card metric-card">
        <div class="metric-value" style="color: #2e7d32;">@Model.TotalEnrollments</div>
        <div class="metric-label">Enrollments</div>
    </div>
</div>

<!-- Completion Rate -->
<div class="card mb-xl">
    <h3>Completion Rate</h3>
    <p style="font-size:1.5rem; font-weight:500;">@Model.CompletionRate</p>
</div>

<!-- Recent Activity -->
<div class="card">
    <h3>Recent Activity</h3>
    @if (Model.RecentActivity.Count == 0)
    {
        <p class="text-faint">No recent activity.</p>
    }
    else
    {
        <ul class="activity-list">
            @foreach (var activity in Model.RecentActivity)
            {
                <li>
                    <span class="badge @(activity.ActivityType == "enrollment" ? "badge-enrolled" : "badge-category")">
                        @activity.ActivityType
                    </span>
                    <span>@activity.Description</span>
                    <span class="activity-time" style="float:right;">
                        @activity.OccurredAt.ToString("MMM dd, HH:mm")
                    </span>
                </li>
            }
        </ul>
    }
</div>
