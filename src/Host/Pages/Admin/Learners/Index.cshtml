@page
@model LibreLms.Host.Pages.Admin.Learners.IndexModel
@{
    ViewData["Title"] = "Learner Management";
}

<h1>Learner Management</h1>

<p class="mb-lg">
    <a asp-page="Create" class="btn btn-primary">Create Learner</a>
</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="get" class="filters">
    <input type="hidden" name="pageNumber" value="1" />
    <input name="search" value="@Model.Search" placeholder="Search by name or email..." />
    <select name="org" class="form-select">
        @foreach (var item in Model.OrgFilter?.ToList() ?? Enumerable.Empty<SelectListItem>())
        {
            <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
        }
    </select>
    <select name="role" class="form-select">
        @foreach (var item in Model.RoleFilter?.ToList() ?? Enumerable.Empty<SelectListItem>())
        {
            <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
        }
    </select>
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a asp-page="Index" class="btn btn-secondary">Clear</a>
</form>

@if (Model.Users.Count == 0)
{
    <div class="empty-state">No learners found.</div>
}
else
{
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Organization</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td class="email-cell">@user.Email</td>
                        <td>
                            <span class="badge @(user.Role == "SuperUser" ? "badge-category" : user.Role == "OrgAdmin" ? "badge-duration" : "badge-enrolled")">@user.Role</span>
                        </td>
                        <td>@user.OrganizationName</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Pagination != null)
{
    <partial name="_AdminPagination" model="Model.Pagination" />
}
