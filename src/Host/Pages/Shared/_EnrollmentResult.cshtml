@using LibreLms.Host.Pages.Courses
@model EnrollmentResult

@if (Model.Success)
{
    <div>
        <span class="badge badge-enrolled">✓ Enrolled</span>
        @if (Model.IsScorm == true)
        {
            <a asp-page="/Scorm/Launch" asp-route-courseId="@Model.CourseId" class="btn btn-primary">Launch SCORM Course</a>
        }
    </div>
}
else if (Model.MessageType == "warning")
{
    <div>
        <span style="color: #f57c00; font-weight: 500;">@Model.Message</span>
    </div>
}
else
{
    <div>
        <span style="color: #c62828; font-weight: 500;">@Model.Message</span>
        <form hx-post="/Courses/Detail?handler=Enroll"
              hx-vals='{"courseId": "@Model.CourseId"}'
              hx-swap="outerHTML"
              hx-target="#enroll-region"
              >
            <button type="submit" class="btn btn-primary">Retry</button>
        </form>
    </div>
}
