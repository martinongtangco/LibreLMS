@using LibreLms.Host.Pages.MyCourses
@model IEnumerable<EnrollmentRow>

@if (!Model.Any())
{
    <div class="card empty-state" style="padding: 3rem 2rem;">
        <h3>You haven't enrolled in any courses yet.</h3>
        <p class="text-muted mt-sm">Browse the course catalog to find something interesting.</p>
        <a href="/Courses" class="btn btn-primary mt-md">Browse Courses</a>
    </div>
}
else
{
    <div class="card">
        @foreach (var row in Model)
        {
            @await Html.PartialAsync("_MyCourseRow", row)
        }
    </div>
}
