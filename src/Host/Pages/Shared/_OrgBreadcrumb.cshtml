@model List<LibreLms.Modules.Management.Endpoints.OrganizationPickerDto>

<nav aria-label="Organization breadcrumb" class="mb-md">
    <ol class="org-breadcrumb">
        @for (int i = 0; i < Model.Count; i++)
        {
            var org = Model[i];
            if (i > 0)
            {
                <li class="separator">›</li>
            }
            <li>
                @if (i < Model.Count - 1)
                {
                    <a href="#">@org.Name</a>
                }
                else
                {
                    <span style="font-weight:500;">@org.Name</span>
                }
            </li>
        }
    </ol>
</nav>
