<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Libre LMS</title>
    <link href="/css/site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar">
        <span class="brand">Libre LMS</span>
        <button class="hamburger-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
        <div class="nav-links" id="nav-links">
            <a asp-page="/Courses/Index">Browse Courses</a>
            <a asp-page="/MyCourses/Index">My Courses</a>
            @if (User.IsInRole("Admin") || User.IsInRole("SuperUser") || User.IsInRole("OrgAdmin"))
            {
                <a asp-page="/Admin/Dashboard/Index">Dashboard</a>
                <a asp-page="/Admin/Organizations/Index">Organizations</a>
                <a asp-page="/Admin/Organizations/Chart">Org Chart</a>
                <a asp-page="/Admin/Learners/Index">Learners</a>
                <a asp-page="/Admin/Courses/Index">Courses</a>
                <a asp-page="/Admin/Enrollments/Index">Enrollments</a>
                <a asp-page="/Admin/Courses/Create">Create Course</a>
                <a asp-page="/Admin/Upload">Upload SCORM</a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="nav-user">
                    <span style="color: #aaa;">@User.Identity.Name</span>
                    <form method="post" asp-page="/Account/Logout" style="display: inline;">
                        <button type="submit" class="btn" style="background: none; border: none; color: white; cursor: pointer; font-size: inherit; text-decoration: none; font-weight: 500; padding: var(--spacing-sm) 0; min-height: auto;">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <a asp-page="/Account/Login">Login</a>
            }
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <div class="footer">&copy; 2025 Libre LMS</div>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <script>
        // Hamburger menu toggle
        (function() {
            var toggle = document.getElementById('nav-toggle');
            var nav = document.getElementById('nav-links');
            if (toggle && nav) {
                toggle.addEventListener('click', function() {
                    var isOpen = nav.classList.toggle('is-open');
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });
            }
        })();
    </script>
</body>
</html>
