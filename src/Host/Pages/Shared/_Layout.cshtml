@using System.Security.Claims
@using LibreLms.Host.ManagementAuth
@* Theme (spec 042): the always-present ThemePreference claim drives the data-theme
   attribute. Explicit Dark/Light render server-side (correct from first paint);
   System, anonymous, or unknown values render an empty attribute, which the inline
   script below resolves from the device setting before site.css paints. *@
@{
    var themeClaim = User.FindFirstValue(ThemeClaimTypes.ThemePreference);
    var dataTheme = themeClaim == "Dark" ? "dark" : themeClaim == "Light" ? "light" : string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-theme="@dataTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Libre LMS</title>
    @* Theme: System resolution + live device follow (spec 042) — must run before site.css paints. *@
    <script>
        (function() {
            // An explicit server-rendered theme (dark/light) wins; empty/absent means System.
            var existing = document.documentElement.getAttribute('data-theme');
            if (existing === 'dark' || existing === 'light') return;
            var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
            function apply() {
                document.documentElement.dataset.theme = (mq && mq.matches) ? 'dark' : 'light';
            }
            apply();
            if (mq && mq.addEventListener) mq.addEventListener('change', apply);
            else if (mq && mq.addListener) mq.addListener(apply);
        })();
    </script>
    <link href="/css/site.css" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="brand">Libre LMS</a>

        @* Server-side role check — computed outside the if block so it's in scope for the script tag too *@
        @{
            var hasAdminRole = User.Identity?.IsAuthenticated == true
                && (User.IsInRole("SuperUser") || User.IsInRole("OrgAdmin"));
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="hamburger-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
                <i data-lucide="menu"></i>
            </button>

            <div class="nav-links" id="nav-links">
                @* Mobile-only role pill — shown only to users with admin roles *@
                @if (hasAdminRole)
                {
                    <div class="mobile-role-pill">
                        <div class="role-pill" id="role-pill-mobile">
                            <button type="button" class="role-segment" data-value="learner">Learner</button>
                            <button type="button" class="role-segment" data-value="admin">Admin</button>
                        </div>
                    </div>
                }

                <a asp-page="/MyCourses/Index" class="nav-link" data-page="my-courses">
                    <i data-lucide="graduation-cap" class="nav-icon"></i> My Courses
                </a>
                <a asp-page="/Courses/Index" class="nav-link" data-page="browse-courses">
                    <i data-lucide="book-open" class="nav-icon"></i> Browse Courses
                </a>
                @if (hasAdminRole)
                {
                    <a asp-page="/Admin/Dashboard/Index" class="nav-link admin-link" data-role-link="admin" data-page="dashboard">
                        <i data-lucide="layout-dashboard" class="nav-icon"></i> Dashboard
                    </a>
                    <a asp-page="/Admin/Courses/Index" class="nav-link admin-link" data-role-link="admin" data-page="admin-courses">
                        <i data-lucide="layers" class="nav-icon"></i> Courses
                    </a>
                    <a asp-page="/Admin/Enrollments/Index" class="nav-link admin-link" data-role-link="admin" data-page="admin-enrollments">
                        <i data-lucide="users" class="nav-icon"></i> Enrollments
                    </a>
                    <a asp-page="/Admin/Learners/Index" class="nav-link admin-link" data-role-link="admin" data-page="admin-learners">
                        <i data-lucide="user-round" class="nav-icon"></i> Learners
                    </a>
                    <a asp-page="/Admin/Organizations/Index" class="nav-link admin-link" data-role-link="admin" data-page="admin-orgs">
                        <i data-lucide="building-2" class="nav-icon"></i> Organizations
                    </a>
                    <a asp-page="/Admin/Upload" class="nav-link admin-link" data-role-link="admin" data-page="admin-upload">
                        <i data-lucide="upload" class="nav-icon"></i> Upload
                    </a>
                }
            </div>

            <div style="flex: 1"></div>

            @* Account Control (spec 020) — div role=button, NOT a button *@
            <div class="account-control" id="account-control" role="button" tabindex="0" aria-label="Account menu" aria-expanded="false">
                @* Role toggle pill — shown only to users with admin roles *@
                @if (hasAdminRole)
                {
                    <div class="role-pill" id="role-pill" onclick="event.stopPropagation()">
                        <button type="button" class="role-segment" data-value="learner">Learner</button>
                        <button type="button" class="role-segment" data-value="admin">Admin</button>
                    </div>
                }

                @* Display avatar (spec 030 R3) — sourced purely from the AvatarPath
                   cookie claim (no service injection / DB access in the layout). For
                   admin-role users the CSS rule ".role-admin .account-avatar" hides it
                   while the nav is in the Admin view (Q1 = C). *@
                @{
                    var avatarPath = User.FindFirstValue(AvatarClaimTypes.AvatarPath);
                    var displayName = User.Identity?.Name ?? string.Empty;
                    var avatarInitial = displayName.Length > 0 ? char.ToUpperInvariant(displayName[0]).ToString() : "?";
                }
                @if (!string.IsNullOrEmpty(avatarPath))
                {
                    <img class="account-avatar" id="nav-avatar" src="@avatarPath" alt="" />
                }
                else
                {
                    <span class="account-avatar account-avatar-fallback" id="nav-avatar" aria-hidden="true">@avatarInitial</span>
                }

                @* Static name — does NOT change with role toggle *@
                <span class="account-name">@User.Identity.Name</span>

                @* Chevron-down icon *@
                <i data-lucide="chevron-down" class="account-chevron"></i>

                @* Account dropdown *@
                <div class="account-dropdown" id="account-dropdown">
                    <a asp-page="/Account/Profile">
                        <i data-lucide="user" class="dropdown-icon"></i> View Profile
                    </a>
                    <a asp-page="/Account/Settings">
                        <i data-lucide="settings" class="dropdown-icon"></i> Settings
                    </a>
                </div>
            </div>
        }
        else
        {
            <div style="flex: 1"></div>
            <a asp-page="/Account/Login" class="nav-link">
                <i data-lucide="log-in" class="nav-icon"></i> Login
            </a>
        }
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <div class="footer">&copy; 2025 Libre LMS</div>

    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <script>
        // Initialize Lucide icons
        (function() {
            lucide.createIcons({ attributes: { 'stroke-width': 2.75 } });
        })();

        // ── Active link detection (spec 020; matching rule fixed in spec 034) ──
        // Keys are SECTION paths (the folder each link's page lives in; for the leaf
        // page /Admin/Upload the page path IS the section). A link is active when the
        // pathname equals its section or lies under it (section + '/'). The LONGEST
        // matching section wins, so '/Admin/Courses/Index' highlights "Courses" (admin)
        // — the old substring check made '/Courses/Index' ("Browse Courses") match
        // first because it is contained in that URL.
        (function() {
            var path = window.location.pathname;
            var linkMap = {
                '/MyCourses': 'my-courses',
                '/Courses': 'browse-courses',
                '/Admin/Dashboard': 'dashboard',
                '/Admin/Courses': 'admin-courses',
                '/Admin/Enrollments': 'admin-enrollments',
                '/Admin/Learners': 'admin-learners',
                '/Admin/Organizations': 'admin-orgs',
                '/Admin/Upload': 'admin-upload'
            };
            var bestKey = null;
            for (var urlPage in linkMap) {
                var isExact = path === urlPage;
                var isSubpage = path.length > urlPage.length && path.indexOf(urlPage + '/') === 0;
                if ((isExact || isSubpage) && (bestKey === null || urlPage.length > bestKey.length)) {
                    bestKey = urlPage;
                }
            }
            if (bestKey !== null) {
                var activeLink = document.querySelector('a.nav-link[data-page="' + linkMap[bestKey] + '"]');
                if (activeLink) activeLink.classList.add('active');
            }
        })();

        // ── Role switcher — client-side nav link visibility toggle (spec 020) ──
        (function() {
            var hasAdminRole = @(hasAdminRole ? "true" : "false");

            // Pure Learners: no toggle, no admin links — just return early
            if (!hasAdminRole) return;

            function setRole(role) {
                var pills = document.querySelectorAll('.role-pill');

                // Update all role pills (desktop + mobile)
                pills.forEach(function(pill) {
                    pill.setAttribute('data-role', role);
                    var segments = pill.querySelectorAll('.role-segment');
                    segments.forEach(function(seg) {
                        seg.classList.toggle('active', seg.getAttribute('data-value') === role);
                    });
                });
                // Toggle admin links visibility using CSS class on body
                if (role === 'admin') {
                    document.body.classList.add('role-admin');
                    document.body.classList.remove('role-learner');
                } else {
                    document.body.classList.add('role-learner');
                    document.body.classList.remove('role-admin');
                }
                localStorage.setItem('nav-role-view', role);
            }

            // Initialize from localStorage or default to admin for admin-capable users
            var saved = localStorage.getItem('nav-role-view') || 'admin';
            setRole(saved);

            // Bind clicks on all role segments
            document.querySelectorAll('.role-pill .role-segment').forEach(function(seg) {
                seg.addEventListener('click', function(e) {
                    e.stopPropagation();
                    setRole(seg.getAttribute('data-value'));
                });
            });
        })();

        // ── Hamburger menu toggle (spec 020) ─────────────────────────────
        (function() {
            var toggle = document.getElementById('nav-toggle');
            var nav = document.getElementById('nav-links');
            if (toggle && nav) {
                toggle.addEventListener('click', function() {
                    var isOpen = nav.classList.toggle('is-open');
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    // Also close account dropdown if open
                    var dd = document.getElementById('account-dropdown');
                    var ac = document.getElementById('account-control');
                    if (dd && ac) {
                        dd.classList.remove('is-open');
                        ac.classList.remove('is-open');
                        ac.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        })();

        // ── Account control dropdown toggle (spec 020) ──────────────────
        (function() {
            var control = document.getElementById('account-control');
            var dropdown = document.getElementById('account-dropdown');
            if (!control || !dropdown) return;

            function toggleDropdown() {
                var isOpen = dropdown.classList.toggle('is-open');
                control.classList.toggle('is-open');
                control.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }

            // Close hamburger nav when dropdown opens
            function closeHamburger() {
                var nav = document.getElementById('nav-links');
                if (nav) nav.classList.remove('is-open');
                var toggle = document.getElementById('nav-toggle');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
            }

            control.addEventListener('click', function(e) {
                // Only toggle if click is NOT on the role pill
                if (e.target.closest('.role-pill')) return;
                toggleDropdown();
                closeHamburger();
            });

            // Keyboard support
            control.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    toggleDropdown();
                    closeHamburger();
                }
                if (e.key === 'Escape') {
                    dropdown.classList.remove('is-open');
                    control.classList.remove('is-open');
                    control.setAttribute('aria-expanded', 'false');
                }
            });

            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (!control.contains(e.target)) {
                    dropdown.classList.remove('is-open');
                    control.classList.remove('is-open');
                    control.setAttribute('aria-expanded', 'false');
                }
            });

            // Close dropdown on navigation (link clicks inside dropdown)
            dropdown.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', function() {
                    dropdown.classList.remove('is-open');
                    control.classList.remove('is-open');
                    control.setAttribute('aria-expanded', 'false');
                });
            });
        })();
    </script>
</body>
</html>
