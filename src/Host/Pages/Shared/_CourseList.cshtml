@using LibreLms.Host.Pages.Courses
@model IEnumerable<CourseItem>

@if (!Model.Any())
{
    <div class="card empty-state" style="padding: 2rem;">
        <p class="text-muted">No courses match your search.</p>
    </div>
}
else
{
    <div class="metric-cards">
        @foreach (var course in Model)
        {
            @await Html.PartialAsync("_CourseCard", course)
        }
    </div>
}
