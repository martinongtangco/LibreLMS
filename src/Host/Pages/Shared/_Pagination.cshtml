@model (int PageNumber, int TotalCount, int PageSize, string? Search, string? Category)

@{
    var (pageNumber, totalCount, pageSize, search, category) = Model;
    var totalPages = totalCount > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
}

@if (totalPages > 1)
{
    <nav class="pagination" style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.5rem; padding: 0.5rem 0;">
        <button class="btn btn-sm btn-ghost"
                @(pageNumber == 1 ? "disabled" : "")
                hx-get="@($"Courses/Index?handler=CourseList&search={System.Uri.EscapeDataString(search ?? "")}&category={System.Uri.EscapeDataString(category ?? "")}&page={pageNumber - 1}")"
                hx-target="#course-list"
                hx-indicator=".htmx-indicator"
                hx-include="#filter-form">
            ← Previous
        </button>

        <span class="text-muted" style="font-size: 0.875rem;">
            Page @pageNumber of @totalPages (@totalCount total)
        </span>

        <button class="btn btn-sm btn-ghost"
                @(pageNumber >= totalPages ? "disabled" : "")
                hx-get="@($"Courses/Index?handler=CourseList&search={System.Uri.EscapeDataString(search ?? "")}&category={System.Uri.EscapeDataString(category ?? "")}&page={pageNumber + 1}")"
                hx-target="#course-list"
                hx-indicator=".htmx-indicator"
                hx-include="#filter-form">
            Next →
        </button>
    </nav>
}
