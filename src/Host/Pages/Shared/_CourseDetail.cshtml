@using LibreLms.Host.Pages.Courses
@model CourseDetailItem

<div class="back-link mb-md">
    <a href="/Courses"
       hx-get="/Courses/Index?handler=CourseList"
       hx-target="#main-content"
       class="link-muted">&larr; Back to Catalog</a>
</div>

<div class="card">
    <h1>@Model.Title</h1>
    <div class="course-card-badges">
        <span class="badge badge-category">@Model.Category</span>
        <span class="badge badge-duration">@Model.Duration</span>
    </div>
    <p class="mb-md">@Model.ShortDescription</p>
    <hr class="separator" />
    <h3>Full Description</h3>
    <p class="mt-sm" style="white-space: pre-wrap;">@Model.FullDescription</p>

    <div id="enroll-region" class="enroll-region">
        @if (Model.IsEnrolled)
        {
            <span class="badge badge-enrolled">✓ Enrolled</span>
            @if (Model.IsScorm)
            {
                <a asp-page="/Scorm/Launch" asp-route-courseId="@Model.Id" class="btn btn-primary">Launch SCORM Course</a>
            }
        }
        else
        {
            <form hx-post="/Courses/Detail?handler=Enroll"
                  hx-vals='{"courseId": "@Model.Id"}'
                  hx-swap="outerHTML"
                  hx-target="#enroll-region">
                <button type="submit" class="btn btn-primary">Enroll in This Course</button>
            </form>
        }
    </div>
</div>
