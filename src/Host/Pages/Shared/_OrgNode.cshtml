@model LibreLms.Host.Pages.Admin.Organizations.OrgTreeNode

<div class="card org-node" style="margin-left: @(Model.ParentId.HasValue ? "20px" : "0");">
    <div class="card" style="padding: var(--spacing-sm) var(--spacing-md);">
        <strong>@Model.Name</strong>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <span class="text-muted"> — @Model.Description</span>
        }
        <div class="mt-sm">
            <a asp-page="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
            @if (!Model.ParentId.HasValue)
            {
                <span class="badge badge-duration">Root</span>
            }
        </div>
    </div>
</div>

@if (Model.Children.Any())
{
    @foreach (var child in Model.Children)
    {
        <partial name="_OrgNode" model="child" />
    }
}
