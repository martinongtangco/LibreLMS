@model LibreLms.Host.Pages.Admin.Organizations.OrgTreeNode

<li class="org-node@(Model.ParentId.HasValue ? string.Empty : " org-node--root")@(Model.IsDisabled ? " org-node--disabled" : string.Empty)">
    <div class="org-node__card">
        <span class="org-node__name">@Model.Name</span>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <span class="org-node__description">@Model.Description</span>
        }
        @if (!Model.ParentId.HasValue)
        {
            <span class="badge org-node__root-badge">Root</span>
        }
        @if (Model.IsDisabled)
        {
            <span class="badge org-node__disabled-badge">Disabled</span>
        }
        <div class="org-node__actions">
            <a asp-page="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
        </div>
    </div>
    @if (Model.Children.Any())
    {
        <ul class="org-tree org-tree--nested">
            @foreach (var child in Model.Children)
            {
                <partial name="_OrgNode" model="child" />
            }
        </ul>
    }
</li>
