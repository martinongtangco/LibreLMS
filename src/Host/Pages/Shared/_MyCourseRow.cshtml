@using LibreLms.Host.Pages.MyCourses
@model EnrollmentRow
@{
    var displayLabel = ScormHelpers.GetDisplayLabel(Model.LatestStatus);
    var (bgColor, textColor) = ScormHelpers.GetStatusBadgeColors(Model.LatestStatus);
    var displayPercentage = ScormHelpers.GetDisplayPercentage(Model.LatestScore);
}

<div class="my-course-row">
    <div class="course-info">
        <strong>
            <a asp-page="/Courses/Detail" asp-route-id="@Model.CourseId">@Model.CourseTitle</a>
        </strong>
        <div class="text-faint" style="font-size: 0.85rem;">Enrolled @Model.EnrolledAt.ToString("MMM d, yyyy")</div>
    </div>
    <div class="course-status">
        <span class="badge" style="background: @bgColor; color: @textColor;">
            @displayLabel
        </span>
        @if (Model.LatestScore.HasValue)
        {
            <span class="text-muted" style="font-size: 0.85rem;">@displayPercentage</span>
        }
    </div>
</div>
