@using LibreLms.Host.Pages.MyCourses
@model EnrollmentRow

<div class="my-course-row">
    <div class="course-info">
        <strong>
            <a asp-page="/Courses/Detail" asp-route-id="@Model.CourseId">@Model.CourseTitle</a>
        </strong>
        <div class="enrollment-meta">
            Enrolled @Model.EnrolledAt.ToString("MMM d, yyyy") · @Model.ProgressPercent% complete
        </div>
        <div class="progress-track mt-sm" style="max-width: 200px;">
            <div class="progress-fill" style="width: @Model.ProgressPercent%;"></div>
        </div>
    </div>
    <div class="course-status">
        <span class="tag @Model.StatusTagClass">
            @Model.StatusLabel
        </span>
    </div>
</div>
