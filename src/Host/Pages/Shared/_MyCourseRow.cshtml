@model EnrollmentRow

<div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid #eee;">
    <div>
        <strong>
            <a asp-page="/Courses/Detail" asp-route-id="@Model.CourseId" style="color: #333; text-decoration: none;">@Model.CourseTitle</a>
        </strong>
        <div style="color: #999; font-size: 0.85rem;">Enrolled @Model.EnrolledAt.ToString("MMM d, yyyy")</div>
    </div>
    <div>
        @if (!string.IsNullOrEmpty(Model.LatestStatus))
        {
            <span class="badge" style="background: @(Model.LatestStatus switch
            {
                "completed" => "#e8f5e9",
                "passed" => "#e8f5e9",
                "in-progress" => "#fff3e0",
                _ => "#f5f5f5"
            }); color: @(Model.LatestStatus switch
            {
                "completed" => "#2e7d32",
                "passed" => "#2e7d32",
                "in-progress" => "#e65100",
                _ => "#666"
            });">
                @(Model.LatestStatus switch
                {
                    "completed" => "✓ Completed",
                    "passed" => "✓ Passed",
                    "in-progress" => "In Progress",
                    _ => Model.LatestStatus
                })
            </span>
            @if (Model.LatestScore.HasValue)
            {
                <span style="margin-left: 0.5rem; font-size: 0.85rem; color: #666;">Score: @Model.LatestScore.Value</span>
            }
        }
        else
        {
            <span class="badge" style="background: #f5f5f5; color: #666;">Not Started</span>
        }
    </div>
</div>
