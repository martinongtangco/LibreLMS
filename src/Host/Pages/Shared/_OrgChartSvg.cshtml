@model IList<LibreLms.Modules.Management.Endpoints.OrgChartNodeDto>
@* 
    SVG partial for rendering the organization chart nodes and connectors.
    All SVG is generated as a raw HTML string to avoid Razor's <text> tag conflict.
*@

@{
    var nodeMap = Model.ToDictionary(node => node.Id);
    var sb = new System.Text.StringBuilder();

    <style>
        .org-node rect { fill: #ffffff; stroke: #1a1a2e; stroke-width: 2; rx: 6; }
        .org-node.disabled rect { fill: #e0e0e0; stroke: #999; stroke-width: 1; }
        .org-node:hover rect { fill: #e3f2fd; }
        .connector { fill: none; stroke: #bbb; stroke-width: 2; }
    </style>

    /* ── Connectors (parent → child) ─────────────────────── */
    foreach (var node in Model.Where(node => node.ParentId.HasValue && nodeMap.ContainsKey(node.ParentId.Value)))
    {
        var parent = nodeMap[node.ParentId.Value];
        int parentX = parent.X + 120;
        int parentY = parent.Y + 50;
        int childX = node.X + 120;
        int childY = node.Y;
        int midY = (parentY + childY) / 2;

        sb.Append($"<path class=\"connector\" d=\"M {parentX},{parentY} C {parentX},{midY} {childX},{midY} {childX},{childY}\" />");
    }

    /* ── Nodes ───────────────────────────────────────────── */
    foreach (var node in Model)
    {
        string disabledClass = node.IsDisabled ? " disabled" : "";
        string nodeId = $"node-{node.Id:D}";
        string nameColor = node.IsDisabled ? "#666" : "#1a1a2e";
        string descColor = node.IsDisabled ? "#999" : "#666";
        string escapedName = System.Web.HttpUtility.HtmlEncode(node.Name);
        string descText = string.IsNullOrEmpty(node.Description) ? "" :
            (node.Description.Length > 40 ? node.Description.Substring(0, 40) + "…" : node.Description);
        string escapedDesc = System.Web.HttpUtility.HtmlEncode(descText);

        sb.Append($"<g class=\"org-node{disabledClass}\" id=\"{nodeId}\" data-org-id=\"{node.Id}\" data-disabled=\"{node.IsDisabled}\" data-root=\"{node.IsRoot}\" transform=\"translate({node.X}, {node.Y})\">");
        sb.Append($"<rect width=\"240\" height=\"50\" />");
        sb.Append($"<text class=\"org-name\" x=\"12\" y=\"22\" font-size=\"13\" font-weight=\"600\" fill=\"{nameColor}\">{escapedName}</text>");
        if (!string.IsNullOrEmpty(descText))
        {
            sb.Append($"<text class=\"org-desc\" x=\"12\" y=\"38\" font-size=\"11\" fill=\"{descColor}\">{escapedDesc}</text>");
        }
        sb.Append($"<rect x=\"155\" y=\"8\" width=\"36\" height=\"18\" rx=\"9\" fill=\"#e3f2fd\" />");
        sb.Append($"<text x=\"173\" y=\"21\" text-anchor=\"middle\" fill=\"#1565c0\" font-size=\"10\" font-weight=\"500\">👤 {node.UserCount}</text>");
        sb.Append($"<rect x=\"197\" y=\"8\" width=\"36\" height=\"18\" rx=\"9\" fill=\"#f3e5f5\" />");
        sb.Append($"<text x=\"215\" y=\"21\" text-anchor=\"middle\" fill=\"#7b1fa2\" font-size=\"10\" font-weight=\"500\">📚 {node.CourseCount}</text>");
        if (node.IsDisabled)
        {
            sb.Append($"<text x=\"12\" y=\"50\" font-size=\"9\" fill=\"#999\" font-style=\"italic\">Disabled</text>");
        }
        if (node.IsRoot)
        {
            sb.Append($"<text x=\"228\" y=\"50\" font-size=\"9\" fill=\"#666\" text-anchor=\"end\">Root</text>");
        }
        sb.Append("</g>");
    }

    var svgHtml = sb.ToString();
}

@Html.Raw(svgHtml)
