@page

@model MyCoursesModel
@{
    ViewData["Title"] = "My Courses";
}

<h1 style="margin-bottom: 1.5rem;">My Courses</h1>

<div style="margin-bottom: 1rem;">
    <button type="button"
            data-refresh-enrollments
            class="btn btn-secondary"
            hx-get="/MyCourses?handler=Enrollments"
            hx-target="#enrollment-list">↻ Refresh</button>
</div>

<div id="enrollment-list"
     hx-get="/MyCourses?handler=Enrollments"
     hx-trigger="load">
    @await Html.PartialAsync("_EnrollmentList", Model.EnrollmentRows)
</div>
