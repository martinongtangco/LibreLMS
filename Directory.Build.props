<Project>

  <!--
    Shared build settings for every project in the solution (spec 053).

    NU1903 (package with a known high-severity vulnerability) is promoted
    to an ERROR: a vulnerable dependency must fail the build instead of
    landing as a waved-through warning.

    System.Security.Cryptography.Xml/.Pkcs are pinned to 11.0.0 (GA on
    NuGet as of 2026-11-21) because 9.0.20 — pulled transitively by
    Microsoft.EntityFrameworkCore.Design -> Microsoft.Build.Tasks.Core —
    carries high-severity advisories (GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6,
    GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83) disclosed after the 9.0.20
    pin of 2026-09-14. The packages are framework-provided assemblies on
    net10.0, so the pin changes no runtime behavior (spike/speckit-verification,
    2026-11-21: the 9.0.20 pin made `dotnet restore` fail at HEAD).
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>NU1903</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

</Project>
